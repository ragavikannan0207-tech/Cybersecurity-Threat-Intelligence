# Cybersecurity Threat Intelligence Database - environment variables
# Copy this file to .env and fill in real values. Never commit .env.

SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=mysql+pymysql://threatuser:threatpass@127.0.0.1:3306/ThreatIntelDB?charset=utf8mb4
SESSION_COOKIE_SECURE=false
FLASK_DEBUG=false
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
REPORTS_PER_PAGE=10
THREATS_PER_PAGE=10
LOG_LEVEL=INFO
